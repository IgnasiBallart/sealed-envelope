# Copy to .env.local for development. Never commit real values.

# Public base URL, used for Stripe redirects and links in emails.
APP_URL=http://localhost:3000

# Stripe test mode only (https://dashboard.stripe.com/test/apikeys).
STRIPE_SECRET_KEY=sk_test_...
# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_...

# At least 32 random characters: `openssl rand -base64 48`.
# Download links are derived from it: changing it breaks every link already sent.
DOWNLOAD_TOKEN_SECRET=

# Adapters: local (default) or AWS. `terraform output app_env` in infra/app prints the AWS block.
# ORDER_STORE: local | dynamodb, FILE_STORE: local | s3, MAILER: console | ses
ORDER_STORE=local
FILE_STORE=local
MAILER=console
LOCAL_DATA_DIR=.data
LOCAL_PDF_DIR=storage/pdfs
MAIL_FROM="Sealed Envelope <no-reply@localhost>"

# Only with the AWS adapters. Credentials come from the AWS SDK default chain
# (locally: AWS_PROFILE; deployed: the compute role).
# AWS_PROFILE=personal
# AWS_REGION=eu-north-1
# ORDERS_TABLE=sealed-envelope-orders
# PDF_BUCKET=sealed-envelope-pdfs-<account-id>
